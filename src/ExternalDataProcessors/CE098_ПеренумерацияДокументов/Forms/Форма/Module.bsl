#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьОбработку(Команда)
	
	Если Не ЗначениеЗаполнено(ВидДокумента) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не выбран вид документа'"));
		Возврат;
	КонецЕсли;
	
	КоличествоДокументов = ПеренумероватьДокументыНаСервере(ВидДокумента);
	
	Если КоличествоДокументов = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Документы для перенумерации не найдены.'"));
	Иначе
		ПоказатьПредупреждение(, СтрШаблон(НСтр("ru = 'Перенумеровано документов: %1.'"), КоличествоДокументов));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПеренумероватьДокументыНаСервере(п_ВидДокумента)
	
	Запрос = Новый Запрос;
	
	Если п_ВидДокумента = "Ремонт" Тогда
		
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Док.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.Ремонт КАК Док
			|УПОРЯДОЧИТЬ ПО
			|	Док.Дата,
			|	Док.Ссылка";

	ИначеЕсли п_ВидДокумента = "Рекламация" Тогда

		Запрос.Текст =
			"ВЫБРАТЬ
			|	Док.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.Рекламация КАК Док
			|УПОРЯДОЧИТЬ ПО
			|	Док.Дата,
			|	Док.Ссылка";

	Иначе
		ВызватьИсключение НСтр("ru = 'Неподдерживаемый вид документа.'");
	КонецЕсли;
	
	Ссылки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Если Ссылки.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		ПрисвоитьВременныеНомера(Ссылки);
		ПрисвоитьНовыеНомера(Ссылки, п_ВидДокумента);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Ссылки.Количество();
	
КонецФункции

&НаСервереБезКонтекста
Процедура ПрисвоитьВременныеНомера(Ссылки)
	
	Индекс = 0;
	Для Каждого Ссылка Из Ссылки Цикл
		Индекс = Индекс + 1;
		ДокументОбъект = Ссылка.ПолучитьОбъект();
		ДокументОбъект.Номер = "Z" + Формат(Индекс, "ЧЦ=10; ЧВН=; ЧГ=");
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПрисвоитьНовыеНомера(Ссылки, п_ВидДокумента)

	НомерПоПорядку = 0;
	Для Каждого Ссылка Из Ссылки Цикл
		НомерПоПорядку = НомерПоПорядку + 1;
		ДокументОбъект = Ссылка.ПолучитьОбъект();
		
		Если п_ВидДокумента = "Рекламация" Тогда
			ДокументОбъект.Номер = "РК" + Формат(НомерПоПорядку, "ЧЦ=9; ЧВН=; ЧГ=");
		ИначеЕсли п_ВидДокумента = "Ремонт" Тогда
			
			ТипОснования = ТипЗнч(Ссылка.Основание);
			
			Если ТипОснования = Тип("ДокументСсылка.Рекламация") Тогда
				// Номер ремонта повторяет номер рекламации-основания.
				ДокументОбъект.Номер = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка.Основание, "Номер").Номер;
			ИначеЕсли ТипОснования = Тип("ДокументСсылка.ВозвратТоваровОтКлиента") Тогда
				ДокументОбъект.Номер = "В" + Формат(НомерПоПорядку, "ЧЦ=10; ЧВН=; ЧГ=");
			Иначе
				ДокументОбъект.Номер = "РМ" + Формат(НомерПоПорядку, "ЧЦ=9; ЧВН=; ЧГ=");
			КонецЕсли;
			
		КонецЕсли;
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
