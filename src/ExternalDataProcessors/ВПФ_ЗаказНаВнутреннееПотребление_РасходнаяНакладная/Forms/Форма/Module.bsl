
&НаСервере
Процедура СтартНаСервере(ДокСсылкав,ИмяМакета)
	
	ПараметрыИсточникаОбъектыНазначения = новый массив;
	ПараметрыИсточникаОбъектыНазначения.Добавить(ДокСсылкав);
	
	Макеты = Новый ТаблицаЗначений;
	Макеты.Колонки.Добавить("ИмяМакета");
	Макеты.Колонки.Добавить("ИмяВРЕГ");
	Макеты.Колонки.Добавить("СинонимМакета");
	Макеты.Колонки.Добавить("ТабличныйДокумент");
	Макеты.Колонки.Добавить("Экземпляров");
	Макеты.Колонки.Добавить("Картинка");
	Макеты.Колонки.Добавить("ПолныйПутьКМакету");
	Макеты.Колонки.Добавить("ИмяФайлаПечатнойФормы");
			Макет = Макеты.Добавить();
			Макет.ИмяМакета = ИмяМакета;
			Макет.ИмяВРЕГ = ВРег(ИмяМакета);
			Макет.Экземпляров = 1;

	
	КоллекцияПечатныхФорм = Макеты;
	ПараметрыВывода = УправлениеПечатью.ПодготовитьСтруктуруПараметровВывода();
	ОбъектыПечати = Новый СписокЗначений;

ДокументОбъект = РеквизитФормыВЗначение("Объект"); 	
ДокументОбъект.Печать(
		ПараметрыИсточникаОбъектыНазначения,
		КоллекцияПечатныхФорм,
		ОбъектыПечати,
		ПараметрыВывода);
Если КоллекцияПечатныхФорм.Количество() > 0 тогда
	МойТабличныйДокумент =КоллекцияПечатныхФорм[0].ТабличныйДокумент;
КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Старт(Команда)
	СтартНаСервере(Объект.СсылкаНаОбъект, СокрЛП(КомандаПечати));
КонецПроцедуры

