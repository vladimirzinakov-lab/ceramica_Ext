#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Форма открыта для расшифровки: настройки пришли параметром.
	Если Параметры.Свойство("НастройкиОтчета") Тогда
		ОткрытьДляРасшифровки(Параметры.НастройкиОтчета, СтандартнаяОбработка);
		Возврат;
	КонецЕсли;
	
	// Восстанавливаем настройки пользователя (включая отбор из поля «Отбор»), сохранённые
	// при закрытии формы. Отборы формы (склады, артикул) применяются после этого и главнее.
	ЗагрузитьПользовательскиеНастройки();
	
	ИмяОтключаемойГруппировки = ?(ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольКачестваТоваров"),
		"КонтрольКачестваВыключен",
		"КонтрольКачестваВключен");
		
	СтруктураНастроек = Отчет.КомпоновщикНастроек.Настройки.Структура;
	Для Каждого ЭлементСтруктуры Из СтруктураНастроек Цикл
		Если ТипЗнч(ЭлементСтруктуры) = Тип("ТаблицаКомпоновкиДанных") Тогда
			
			Для Каждого СтрокаКомпоновки Из ЭлементСтруктуры.Строки Цикл
				Если ТипЗнч(СтрокаКомпоновки) = Тип("ГруппировкаТаблицыКомпоновкиДанных") Тогда
					Если СтрокаКомпоновки.Имя = ИмяОтключаемойГруппировки Тогда
						ЭлементСтруктуры.Строки.Удалить(СтрокаКомпоновки);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Для Каждого КолонкаКомпоновки Из ЭлементСтруктуры.Колонки Цикл
				Если ТипЗнч(КолонкаКомпоновки) = Тип("ГруппировкаТаблицыКомпоновкиДанных") Тогда
					Если КолонкаКомпоновки.Имя = ИмяОтключаемойГруппировки Тогда
						ЭлементСтруктуры.Колонки.Удалить(КолонкаКомпоновки);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
		ИначеЕсли ТипЗнч(ЭлементСтруктуры) = Тип("ГруппировкаКомпоновкиДанных") Тогда
			
			Если ЭлементСтруктуры.Имя = ИмяОтключаемойГруппировки Тогда
				СтруктураНастроек.Элементы.Удалить(ЭлементСтруктуры);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДоступностьПоДатам = Истина;
	ДоступностьПоДатамПриИзмененииБезКонтекста(Отчет.КомпоновщикНастроек, ДоступностьПоДатам);
	
	// Заполняем таблицу складов, затем собираем отборы. Отбор по номенклатуре
	// (в том числе «В группе из списка») пользователь задаёт в поле «Отбор» на форме.
	ЗаполнитьСкладыОтбора();
	ОтметитьСкладыПоПараметрамОтбора();
	ПрименитьОтборы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	СохранитьПользовательскиеНастройки();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СкладыОтбораОтметкаПриИзменении(Элемент)
	
	ПрименитьОтборы();
	УстановитьСостояниеОтчетНеСформирован();
	
КонецПроцедуры

&НаКлиенте
Процедура СкладыОтбораПриИзменении(Элемент)
	
	ПрименитьОтборы();
	УстановитьСостояниеОтчетНеСформирован();
	
КонецПроцедуры

&НаКлиенте
Процедура АртикулПриИзменении(Элемент)
	
	ПрименитьОтборы();
	УстановитьСостояниеОтчетНеСформирован();
	
КонецПроцедуры

&НаКлиенте
Процедура ДоступностьПоДатамПриИзменении(Элемент)
	
	ДоступностьПоДатамПриИзмененииБезКонтекста(Отчет.КомпоновщикНастроек, ДоступностьПоДатам);
	УстановитьСостояниеОтчетНеСформирован();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьСкладыОтбора()
	
	// Список складов задан в объектном модуле отчёта. РеквизитФормыВЗначение("Отчет")
	// даёт доступ к экспортным методам модуля объекта внешнего отчёта.
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	
	СкладыОтбора.Очистить();
	Для Каждого Описание Из ОтчетОбъект.ОписанияРазрешенныхСкладов() Цикл
		НоваяСтрока = СкладыОтбора.Добавить();
		НоваяСтрока.Склад = Строка(Описание);
		НоваяСтрока.Отметка = Истина;
	КонецЦикла;
	
КонецПроцедуры

// Отмечает склады, переданные в параметре формы "Отбор" (открытие отчёта из интерфейса).
&НаСервере
Процедура ОтметитьСкладыПоПараметрамОтбора()
	
	Если Не Параметры.Свойство("Отбор") ИЛИ Не Параметры.Отбор.Свойство("Склад") Тогда
		Возврат;
	КонецЕсли;
	
	СкладыПараметра = Параметры.Отбор.Склад;
	ЗначенияОтбора = Новый Массив;
	Если ТипЗнч(СкладыПараметра) = Тип("Массив") Тогда
		ЗначенияОтбора = СкладыПараметра;
	ИначеЕсли ТипЗнч(СкладыПараметра) = Тип("СписокЗначений") Тогда
		ЗначенияОтбора = СкладыПараметра.ВыгрузитьЗначения();
	ИначеЕсли ЗначениеЗаполнено(СкладыПараметра) Тогда
		ЗначенияОтбора.Добавить(СкладыПараметра);
	КонецЕсли;
	
	Если ЗначенияОтбора.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Строка Из СкладыОтбора Цикл
		Строка.Отметка = Ложь;
	КонецЦикла;
	Для Каждого Значение Из ЗначенияОтбора Цикл
		Если ТипЗнч(Значение) = Тип("СправочникСсылка.Склады") Тогда
			Для Каждого Строка Из СкладыОтбора Цикл
				Если Строка.Склад = Строка(Значение) Тогда
					Строка.Отметка = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Пересобирает фиксированные настройки отбора отчёта из состояния формы: склады (галочки)
// и артикул. Отбор по номенклатуре (в том числе «В группе из списка») ставит пользователь
// в поле «Отбор» на форме — этот отбор не очищается.
//
// Единая точка: отборы ставятся только здесь и только на сервере. Если ставить их
// по отдельности (часть на клиенте, часть на сервере), правка одного отбора теряет
// другой — например, при выборе артикула список складов сбрасывался в пустой.
// Из настроек варианта элементы по этим же полям удаляются: если по одному полю есть
// элементы и в настройках, и в фиксированных настройках, платформа их не применяет
// («Невозможно применить фиксированные настройки. Пересекаются элементы отбора»).
&НаСервере
Процедура ПрименитьОтборы()
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	
	УдалитьЭлементыОтбораПоПолю("Склад");
	УдалитьЭлементыОтбораПоПолю("Номенклатура.Артикул");
	
	Отбор = Отчет.КомпоновщикНастроек.ФиксированныеНастройки.Отбор;
	
	// Склады: отмеченные на форме. Пустой выбор не допускается — отмечаются все доступные.
	ОписанияОтмеченных = Новый Массив;
	Для Каждого Строка Из СкладыОтбора Цикл
		Если Строка.Отметка Тогда
			ОписанияОтмеченных.Добавить(Строка.Склад);
		КонецЕсли;
	КонецЦикла;
	
	ВыбранныеСклады = ОтчетОбъект.СкладыПоОписаниям(ОписанияОтмеченных);
	Если ВыбранныеСклады.Количество() = 0 Тогда
		Сообщить("Отметьте хотя бы один склад — отбор установлен по всем доступным складам отчёта.",
			СтатусСообщения.Внимание);
		Для Каждого Строка Из СкладыОтбора Цикл
			Строка.Отметка = Истина;
		КонецЦикла;
		ВыбранныеСклады = ОтчетОбъект.РазрешенныеСклады();
	ИначеЕсли ВыбранныеСклады.Количество() < ОписанияОтмеченных.Количество() Тогда
		Сообщить("Из отмеченных складов в базе найдено " + ВыбранныеСклады.Количество()
			+ " из " + ОписанияОтмеченных.Количество() + " — проверьте наименования складов.",
			СтатусСообщения.Внимание);
	КонецЕсли;
	
	Если ВыбранныеСклады.Количество() > 0 Тогда
		ДобавитьЭлементОтбораВСписке(Отбор, "Склад", ВыбранныеСклады);
	КонецЕсли;
	
	// Артикул: вхождение подстроки.
	Если Не ПустаяСтрока(Артикул) Тогда
		ЭлементОтбора = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Номенклатура.Артикул");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит;
		ЭлементОтбора.ПравоеЗначение = Артикул;
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	КонецЕсли;
	
	// Правка настроек сбрасывает флажок колонок дат — фиксируем его заново.
	ДоступностьПоДатамПриИзмененииБезКонтекста(Отчет.КомпоновщикНастроек, ДоступностьПоДатам);
	
КонецПроцедуры

// Добавляет в отбор элемент «В списке» по указанному полю.
&НаСервере
Процедура ДобавитьЭлементОтбораВСписке(Отбор, ИмяПоля, Значения, ВидСравнения = Неопределено)
	
	ЭлементОтбора = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
	ЭлементОтбора.ВидСравнения = ?(ВидСравнения = Неопределено,
		ВидСравненияКомпоновкиДанных.ВСписке, ВидСравнения);
	ЭлементОтбора.ПравоеЗначение = Значения;
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДоступностьПоДатамПриИзмененииБезКонтекста(Компоновщик, ДоступностьПоДатам)
	
	// Флажок передаётся объекту отчёта в дополнительных свойствах пользовательских настроек:
	// сами настройки группировок до компоновки не доходят (платформа сбрасывает их к варианту),
	// поэтому колонки дат включает объектный модуль — ПодготовитьНастройкиКолонок().
	Компоновщик.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ДоступностьПоДатам", ДоступностьПоДатам);
	
	Для Каждого ТаблицаНастроек Из Компоновщик.Настройки.Структура Цикл
		Если ТипЗнч(ТаблицаНастроек) = Тип("ТаблицаКомпоновкиДанных") Тогда
		Для Каждого ЭлементНастроек Из ТаблицаНастроек.Колонки Цикл
			
			НайденнаяГруппировка = НайтиГруппировкуРекурсивно(ЭлементНастроек, "ДатаДоступностиДляСамообслуживания");
			Если НайденнаяГруппировка <> Неопределено Тогда
				
				// Форма внешнего отчёта не применяет пользовательские настройки к компоновщику,
				// поэтому включаем саму группировку, а не только пользовательскую настройку.
				НайденнаяГруппировка.Использование = ДоступностьПоДатам;
				
				ИдентификаторНастройки = НайденнаяГруппировка.ИдентификаторПользовательскойНастройки;
				ПользовательскаяНастройка = Компоновщик.ПользовательскиеНастройки.Элементы.Найти(ИдентификаторНастройки);
				Если ПользовательскаяНастройка <> Неопределено Тогда
					ПользовательскаяНастройка.Использование = ДоступностьПоДатам;
				КонецЕсли;
				
			КонецЕсли;
			
			НайденнаяГруппировка = НайтиГруппировкуРекурсивно(ЭлементНастроек, "КонтрольКачестваДатаДоступности");
			Если НайденнаяГруппировка <> Неопределено Тогда
				
				НайденнаяГруппировка.Использование = ДоступностьПоДатам;
				
				ИдентификаторНастройки = НайденнаяГруппировка.ИдентификаторПользовательскойНастройки;
				ПользовательскаяНастройка = Компоновщик.ПользовательскиеНастройки.Элементы.Найти(ИдентификаторНастройки);
				Если ПользовательскаяНастройка <> Неопределено Тогда
					ПользовательскаяНастройка.Использование = ДоступностьПоДатам;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НайтиГруппировкуРекурсивно(ЭлементНастроек, ИмяГруппировки)
	
	Если ТипЗнч(ЭлементНастроек) = Тип("ГруппировкаТаблицыКомпоновкиДанных") Тогда
		
		Если ЭлементНастроек.Имя = ИмяГруппировки Тогда
			Возврат ЭлементНастроек;
		Иначе
			Для Каждого Элемент Из ЭлементНастроек.Структура Цикл
				
				НайденнаяГруппировка = НайтиГруппировкуРекурсивно(Элемент, ИмяГруппировки);
				Если НайденнаяГруппировка <> Неопределено Тогда
					Возврат НайденнаяГруппировка;
				КонецЕсли;
				
			КонецЦикла;
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Процедура УстановитьСостояниеОтчетНеСформирован()
	
	Элементы.Результат.ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.Неактуальность;
	Элементы.Результат.ОтображениеСостояния.Текст = НСтр("ru = 'Отчет не сформирован. Нажмите ""Сформировать"" для получения отчета.'");
	Элементы.Результат.ОтображениеСостояния.Видимость = Истина;
	
КонецПроцедуры


// Удаляет элементы отбора по указанному полю из настроек варианта и из фиксированных настроек.
&НаСервере
Процедура УдалитьЭлементыОтбораПоПолю(ИмяПоля)

	УдалитьЭлементыОтбораИзКоллекции(Отчет.КомпоновщикНастроек.Настройки.Отбор, ИмяПоля);
	УдалитьЭлементыОтбораИзКоллекции(Отчет.КомпоновщикНастроек.ФиксированныеНастройки.Отбор, ИмяПоля);

КонецПроцедуры

&НаСервере
Процедура УдалитьЭлементыОтбораИзКоллекции(Отбор, ИмяПоля)

	Для Каждого Элемент Из ОбщегоНазначенияКлиентСервер.НайтиЭлементыИГруппыОтбора(Отбор, ИмяПоля) Цикл
		Если ТипЗнч(Элемент) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			Отбор.Элементы.Удалить(Элемент);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
#КонецОбласти

#Область Расшифровка

// Открывает отчёт в режиме расшифровки: применяет переданные настройки и сразу компонует результат.
&НаСервере
Процедура ОткрытьДляРасшифровки(НастройкиОтчета, СтандартнаяОбработка)
	
	Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиОтчета);
	Отчет.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы.Очистить();
	ПодготовитьОтборРасшифровки();
	
	ЗаполнитьСкладыОтбора();
	ОтметитьСкладыПоПараметрамОтбора();
	
	// Отключаем автоформирование, иначе платформа скомпонует отчёт заново
	// по настройкам по умолчанию и расшифровка потеряется.
	СтандартнаяОбработка = Ложь;
	СкомпоноватьРезультат(РежимКомпоновкиРезультата.Непосредственно);
	ЭтотОбъект.Заголовок = ЭтотОбъект.Заголовок + " (Расшифровка)";
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	Если ТипЗнч(Расшифровка) <> Тип("ИдентификаторРасшифровкиКомпоновкиДанных") Тогда
		Возврат;
	КонецЕсли;
	
	ИсточникНастроек = Отчет.КомпоновщикНастроек.ПолучитьИсточникДоступныхНастроек();
	Если ИсточникНастроек = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ОбработкаРасшифровки = Новый ОбработкаРасшифровкиКомпоновкиДанных(
		ДанныеРасшифровки,
		ИсточникНастроек);
	
	ОбработкаРасшифровки.ПоказатьВыборДействия(
		Новый ОписаниеОповещения("РезультатОбработкаРасшифровкиЗавершение", ЭтотОбъект, Расшифровка),
		Расшифровка, , , Истина, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаРасшифровкиЗавершение(ВыбранноеДействие, ПараметрВыбранногоДействия, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеДействие = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ВыбранноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение Тогда
		ПоказатьЗначение(, ПараметрВыбранногоДействия);
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = ПараметрыФормыРасшифровки(ДополнительныеПараметры, ПараметрВыбранногоДействия);
	Если ПараметрыОткрытия = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ОткрытьФорму(ПараметрыОткрытия.ИмяФормы, ПараметрыОткрытия.Параметры, , , , , ,
			РежимОткрытияОкнаФормы.Независимый);
	Исключение
		// Отчёт может быть зарегистрирован под другим именем — пробуем второй вариант.
		Попытка
			ОткрытьФорму(ПараметрыОткрытия.ЗапасноеИмяФормы, ПараметрыОткрытия.Параметры, , , , , ,
				РежимОткрытияОкнаФормы.Независимый);
		Исключение
			Сообщить("Не удалось открыть расшифровку: " + ОписаниеОшибки(), СтатусСообщения.Внимание);
		КонецПопытки;
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция ПараметрыФормыРасшифровки(ИдентификаторРасшифровки, НастройкиДействия)
	
	Если НастройкиДействия = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОбработкаРасшифровки = Новый ОбработкаРасшифровкиКомпоновкиДанных(
		ДанныеРасшифровки,
		Отчет.КомпоновщикНастроек.ПолучитьИсточникДоступныхНастроек());
	
	Настройки = ОбработкаРасшифровки.ПрименитьНастройки(ИдентификаторРасшифровки, НастройкиДействия);
	Если Настройки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Фиксированные настройки формы (склад, номенклатура, артикул) пересекаются с отбором
	// расшифровки — платформа падает «Пересекаются элементы отбора». В окне расшифровки нужен
	// только отбор расшифровки, поэтому фиксированные настройки очищаем перед сборкой настроек.
	Отчет.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы.Очистить();
	
	Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
	ПодготовитьОтборРасшифровки();
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ИмяФормы", "ВнешнийОтчет." + ИмяВнешнегоОтчета() + ".Форма");
	ПараметрыОткрытия.Вставить("ЗапасноеИмяФормы", "ВнешнийОтчет." + ИмяВнешнегоОтчета(Истина) + ".Форма");
	ПараметрыОткрытия.Вставить("Параметры", Новый Структура("НастройкиОтчета",
		Отчет.КомпоновщикНастроек.ПолучитьНастройки()));
	
	Возврат ПараметрыОткрытия;
	
КонецФункции

// Имя, под которым внешний отчёт зарегистрирован в базе.
// Из формы его получить нельзя: у объекта отчёта доступен только КомпоновщикНастроек.
&НаСервере
Функция ИмяВнешнегоОтчета(Запасное = Ложь)
	
	Если Запасное Тогда
		Возврат "ОстаткиИДоступностьТоваровМ";
	КонецЕсли;
	
	Возврат "ОстаткиИДоступностьТоваров";
	
КонецФункции

&НаСервере
Процедура ПодготовитьОтборРасшифровки()
	
	// Поле Склада в регистре составного типа, поэтому скалярное сравнение СКД не может
	// передать значение в параметр виртуальной таблицы. Значение разворачивается в "В списке".
	// Представление пользовательской настройки очищается: иначе объектный модуль подменит
	// отбор по складу на весь разрешённый список.
	Отбор = Отчет.КомпоновщикНастроек.Настройки.Отбор;
	Для Каждого ЭлементОтбора Из Отбор.Элементы Цикл
		
		Если ТипЗнч(ЭлементОтбора) <> Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПоля = Строка(ЭлементОтбора.ЛевоеЗначение);
		
		Если ИмяПоля = "Характеристика" Тогда
			ЭлементОтбора.Использование = Ложь;
		ИначеЕсли ИмяПоля = "Склад" И ЭлементОтбора.ПравоеЗначение <> Неопределено Тогда
			ЗначенияСкладов = Новый Массив;
			ЗначенияСкладов.Добавить(ЭлементОтбора.ПравоеЗначение);
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
			ЭлементОтбора.ПравоеЗначение = ЗначенияСкладов;
			ЭлементОтбора.ПредставлениеПользовательскойНастройки = "";
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#Область ПользовательскиеНастройки

// Настройки отчёта (включая отбор, заданный в поле «Отбор») сохраняются за пользователем
// в хранилище общих настроек и восстанавливаются при открытии формы. Отборы формы
// (склады, артикул) применяются после загрузки и перекрывают сохранённые.

&НаСервере
Процедура ЗагрузитьПользовательскиеНастройки()
	
	Если Не ХранилищеНастроекДоступно() Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		СтрокаНастроек = ХранилищеОбщихНастроек.Загрузить(КлючОбъектаНастроек(), КлючНастроекОтчета(),
			"", "", ТекущийПользовательНастроек());
		Если Не ПустаяСтрока(СтрокаНастроек) Тогда
			Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(ЗначениеИзСтрокиВнутр(СтрокаНастроек));
		КонецЕсли;
	Исключение
		// Настройки сохранены другой версией отчёта или недоступны — работаем по умолчанию.
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьПользовательскиеНастройки()
	
	// Окно расшифровки открывается с чужими настройками — их не сохраняем.
	Если Параметры.Свойство("НастройкиОтчета") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ХранилищеНастроекДоступно() Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ХранилищеОбщихНастроек.Сохранить(КлючОбъектаНастроек(), КлючНастроекОтчета(),
			ЗначениеВСтрокуВнутр(Отчет.КомпоновщикНастроек.ПолучитьНастройки()),
			"", ТекущийПользовательНастроек());
	Исключение
		// Ошибка сохранения не должна мешать закрытию отчёта.
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция КлючОбъектаНастроек()
	
	Возврат "ВнешнийОтчет." + ИмяВнешнегоОтчета();
	
КонецФункции

&НаСервере
Функция КлючНастроекОтчета()
	
	Возврат "ПользовательскиеНастройки";
	
КонецФункции

&НаСервере
Функция ХранилищеНастроекДоступно()
	
	Возврат Метаданные.ОбщиеМодули.Найти("ХранилищеОбщихНастроек") <> Неопределено;
	
КонецФункции

&НаСервере
Функция ТекущийПользовательНастроек()
	
	Если Метаданные.ОбщиеМодули.Найти("Пользователи") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Пользователи.ТекущийПользователь();
	
КонецФункции

#КонецОбласти

#КонецОбласти
