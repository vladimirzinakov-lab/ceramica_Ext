#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИмяОтключаемойГруппировки = ?(ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольКачестваТоваров"),
		"КонтрольКачестваВыключен",
		"КонтрольКачестваВключен");
		
	СтруктураНастроек = Отчет.КомпоновщикНастроек.Настройки.Структура;
	Для Каждого ЭлементСтруктуры Из СтруктураНастроек Цикл
		Если ТипЗнч(ЭлементСтруктуры) = Тип("ТаблицаКомпоновкиДанных") Тогда
			
			Для Каждого СтрокаКомпоновки Из ЭлементСтруктуры.Строки Цикл
				Если ТипЗнч(СтрокаКомпоновки) = Тип("ГруппировкаТаблицыКомпоновкиДанных") Тогда
					Если СтрокаКомпоновки.Имя = ИмяОтключаемойГруппировки Тогда
						ЭлементСтруктуры.Строки.Удалить(СтрокаКомпоновки);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Для Каждого КолонкаКомпоновки Из ЭлементСтруктуры.Колонки Цикл
				Если ТипЗнч(КолонкаКомпоновки) = Тип("ГруппировкаТаблицыКомпоновкиДанных") Тогда
					Если КолонкаКомпоновки.Имя = ИмяОтключаемойГруппировки Тогда
						ЭлементСтруктуры.Колонки.Удалить(КолонкаКомпоновки);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
		ИначеЕсли ТипЗнч(ЭлементСтруктуры) = Тип("ГруппировкаКомпоновкиДанных") Тогда
			
			Если ЭлементСтруктуры.Имя = ИмяОтключаемойГруппировки Тогда
				СтруктураНастроек.Элементы.Удалить(ЭлементСтруктуры);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДоступностьПоДатам = Истина;
	ДоступностьПоДатамПриИзмененииБезКонтекста(Отчет.КомпоновщикНастроек, ДоступностьПоДатам);
	
	// Ограничение набора складов фиксированным списком отчёта.
	ЗаполнитьСкладыОтбора();
	ОтметитьСкладыПоПараметрамОтбора();
	
	// Повторно фиксируем флажок после правок настроек отбором по складам.
	ДоступностьПоДатамПриИзмененииБезКонтекста(Отчет.КомпоновщикНастроек, ДоступностьПоДатам);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СкладыОтбораОтметкаПриИзменении(Элемент)
	
	ПрименитьОтборПоСкладам();
	УстановитьСостояниеОтчетНеСформирован();
	
КонецПроцедуры

&НаКлиенте
Процедура СкладыОтбораПриИзменении(Элемент)
	
	ПрименитьОтборПоСкладам();
	УстановитьСостояниеОтчетНеСформирован();
	
КонецПроцедуры

&НаКлиенте
Процедура АртикулПриИзменении(Элемент)
	
	// Из настроек варианта элемент по артикулу убираем, отбор ставим в фиксированные настройки:
	// иначе платформа не применяет фиксированные настройки по тому же полю.
	УдалитьЭлементыОтбораПоПолю("Номенклатура.Артикул");
	ЭлементыОтбора = Отчет.КомпоновщикНастроек.ФиксированныеНастройки.Отбор;
	Если ПустаяСтрока(Артикул) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементыОтбора, "Номенклатура.Артикул", "", ,,Ложь);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементыОтбора, "Номенклатура.Артикул", Артикул,ВидСравненияКомпоновкиДанных.Содержит , , Истина);
	КонецЕсли;
	
	// Повторно фиксируем флажок «Доступность по датам» после правки настроек.
	ДоступностьПоДатамПриИзмененииБезКонтекста(Отчет.КомпоновщикНастроек, ДоступностьПоДатам);
	
	УстановитьСостояниеОтчетНеСформирован();
	
КонецПроцедуры

&НаКлиенте
Процедура ДоступностьПоДатамПриИзменении(Элемент)
	
	ДоступностьПоДатамПриИзмененииБезКонтекста(Отчет.КомпоновщикНастроек, ДоступностьПоДатам);
	УстановитьСостояниеОтчетНеСформирован();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьСкладыОтбора()
	
	// Список складов задан в объектном модуле отчёта. РеквизитФормыВЗначение("Отчет")
	// даёт доступ к экспортным методам модуля объекта внешнего отчёта.
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	
	СкладыОтбора.Очистить();
	Для Каждого Описание Из ОтчетОбъект.ОписанияРазрешенныхСкладов() Цикл
		НоваяСтрока = СкладыОтбора.Добавить();
		НоваяСтрока.Склад = Строка(Описание);
		НоваяСтрока.Отметка = Истина;
	КонецЦикла;
	
	ПрименитьОтборПоСкладам();
	
КонецПроцедуры

// Отмечает склады, переданные в параметре формы "Отбор" (открытие отчёта из интерфейса).
&НаСервере
Процедура ОтметитьСкладыПоПараметрамОтбора()
	
	Если Не Параметры.Свойство("Отбор") ИЛИ Не Параметры.Отбор.Свойство("Склад") Тогда
		Возврат;
	КонецЕсли;
	
	СкладыПараметра = Параметры.Отбор.Склад;
	ЗначенияОтбора = Новый Массив;
	Если ТипЗнч(СкладыПараметра) = Тип("Массив") Тогда
		ЗначенияОтбора = СкладыПараметра;
	ИначеЕсли ТипЗнч(СкладыПараметра) = Тип("СписокЗначений") Тогда
		ЗначенияОтбора = СкладыПараметра.ВыгрузитьЗначения();
	ИначеЕсли ЗначениеЗаполнено(СкладыПараметра) Тогда
		ЗначенияОтбора.Добавить(СкладыПараметра);
	КонецЕсли;
	
	Если ЗначенияОтбора.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Строка Из СкладыОтбора Цикл
		Строка.Отметка = Ложь;
	КонецЦикла;
	Для Каждого Значение Из ЗначенияОтбора Цикл
		Если ТипЗнч(Значение) = Тип("СправочникСсылка.Склады") Тогда
			Для Каждого Строка Из СкладыОтбора Цикл
				Если Строка.Склад = Строка(Значение) Тогда
					Строка.Отметка = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	ПрименитьОтборПоСкладам();
	
КонецПроцедуры

// Переносит отметки пользователя в фиксированные настройки отчёта.
// Пустой выбор не допускается: отмечаются все доступные склады.
&НаСервере
Процедура ПрименитьОтборПоСкладам()
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	
	ОписанияОтмеченных = Новый Массив;
	Для Каждого Строка Из СкладыОтбора Цикл
		Если Строка.Отметка Тогда
			ОписанияОтмеченных.Добавить(Строка.Склад);
		КонецЕсли;
	КонецЦикла;
	
	Выбранные = ОтчетОбъект.СкладыПоОписаниям(ОписанияОтмеченных);
	Если Выбранные.Количество() = 0 Тогда
		Сообщить("Отметьте хотя бы один склад — отбор установлен по всем доступным складам отчёта.",
			СтатусСообщения.Внимание);
		
		// Диагностика (временно): показывает склады, которые есть в базе, — чтобы поправить список.
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 50
		|	Склады.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Склады КАК Склады
		|ГДЕ
		|	НЕ Склады.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Сообщить("склад в базе: [" + Выборка.Наименование + "]");
		КонецЦикла;
		
		Для Каждого Строка Из СкладыОтбора Цикл
			Строка.Отметка = Истина;
		КонецЦикла;
		Выбранные = ОтчетОбъект.РазрешенныеСклады();
	ИначеЕсли Выбранные.Количество() < ОписанияОтмеченных.Количество() Тогда
		Сообщить("Из отмеченных складов в базе найдено " + Выбранные.Количество()
			+ " из " + ОписанияОтмеченных.Количество() + " — проверьте наименования складов.",
			СтатусСообщения.Внимание);
	КонецЕсли;
	
	УстановитьОтборПоСкладамВНастройках(Выбранные);
	
КонецПроцедуры

// Устанавливает единственный элемент отбора по складу в фиксированных настройках отчёта.
// Из настроек варианта элементы по складу удаляются: если по одному полю есть элементы
// и в настройках, и в фиксированных настройках, платформа их не применяет
// («Невозможно применить фиксированные настройки. Пересекаются элементы отбора»).
&НаСервере
Процедура УстановитьОтборПоСкладамВНастройках(Выбранные)
	
	УдалитьЭлементыОтбораПоПолю("Склад");
	
	Отбор = Отчет.КомпоновщикНастроек.ФиксированныеНастройки.Отбор;
	

	ЭлементОтбора = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Склад");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	ЭлементОтбора.ПравоеЗначение = Выбранные;
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
	// Повторно фиксируем флажок «Доступность по датам» после правки настроек.
	ДоступностьПоДатамПриИзмененииБезКонтекста(Отчет.КомпоновщикНастроек, ДоступностьПоДатам);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДоступностьПоДатамПриИзмененииБезКонтекста(Компоновщик, ДоступностьПоДатам)
	
	// Флажок передаётся объекту отчёта в дополнительных свойствах пользовательских настроек:
	// сами настройки группировок до компоновки не доходят (платформа сбрасывает их к варианту),
	// поэтому колонки дат включает объектный модуль — ПодготовитьНастройкиКолонок().
	Компоновщик.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ДоступностьПоДатам", ДоступностьПоДатам);
	
	Для Каждого ТаблицаНастроек Из Компоновщик.Настройки.Структура Цикл
		Если ТипЗнч(ТаблицаНастроек) = Тип("ТаблицаКомпоновкиДанных") Тогда
		Для Каждого ЭлементНастроек Из ТаблицаНастроек.Колонки Цикл
			
			НайденнаяГруппировка = НайтиГруппировкуРекурсивно(ЭлементНастроек, "ДатаДоступностиДляСамообслуживания");
			Если НайденнаяГруппировка <> Неопределено Тогда
				
				// Форма внешнего отчёта не применяет пользовательские настройки к компоновщику,
				// поэтому включаем саму группировку, а не только пользовательскую настройку.
				НайденнаяГруппировка.Использование = ДоступностьПоДатам;
				
				ИдентификаторНастройки = НайденнаяГруппировка.ИдентификаторПользовательскойНастройки;
				ПользовательскаяНастройка = Компоновщик.ПользовательскиеНастройки.Элементы.Найти(ИдентификаторНастройки);
				Если ПользовательскаяНастройка <> Неопределено Тогда
					ПользовательскаяНастройка.Использование = ДоступностьПоДатам;
				КонецЕсли;
				
			КонецЕсли;
			
			НайденнаяГруппировка = НайтиГруппировкуРекурсивно(ЭлементНастроек, "КонтрольКачестваДатаДоступности");
			Если НайденнаяГруппировка <> Неопределено Тогда
				
				НайденнаяГруппировка.Использование = ДоступностьПоДатам;
				
				ИдентификаторНастройки = НайденнаяГруппировка.ИдентификаторПользовательскойНастройки;
				ПользовательскаяНастройка = Компоновщик.ПользовательскиеНастройки.Элементы.Найти(ИдентификаторНастройки);
				Если ПользовательскаяНастройка <> Неопределено Тогда
					ПользовательскаяНастройка.Использование = ДоступностьПоДатам;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НайтиГруппировкуРекурсивно(ЭлементНастроек, ИмяГруппировки)
	
	Если ТипЗнч(ЭлементНастроек) = Тип("ГруппировкаТаблицыКомпоновкиДанных") Тогда
		
		Если ЭлементНастроек.Имя = ИмяГруппировки Тогда
			Возврат ЭлементНастроек;
		Иначе
			Для Каждого Элемент Из ЭлементНастроек.Структура Цикл
				
				НайденнаяГруппировка = НайтиГруппировкуРекурсивно(Элемент, ИмяГруппировки);
				Если НайденнаяГруппировка <> Неопределено Тогда
					Возврат НайденнаяГруппировка;
				КонецЕсли;
				
			КонецЦикла;
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Процедура УстановитьСостояниеОтчетНеСформирован()
	
	Элементы.Результат.ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.Неактуальность;
	Элементы.Результат.ОтображениеСостояния.Текст = НСтр("ru = 'Отчет не сформирован. Нажмите ""Сформировать"" для получения отчета.'");
	Элементы.Результат.ОтображениеСостояния.Видимость = Истина;
	
КонецПроцедуры


// Удаляет элементы отбора по указанному полю из настроек варианта и из фиксированных настроек.
&НаСервере
Процедура УдалитьЭлементыОтбораПоПолю(ИмяПоля)

	УдалитьЭлементыОтбораИзКоллекции(Отчет.КомпоновщикНастроек.Настройки.Отбор, ИмяПоля);
	УдалитьЭлементыОтбораИзКоллекции(Отчет.КомпоновщикНастроек.ФиксированныеНастройки.Отбор, ИмяПоля);

КонецПроцедуры

&НаСервере
Процедура УдалитьЭлементыОтбораИзКоллекции(Отбор, ИмяПоля)

	Для Каждого Элемент Из ОбщегоНазначенияКлиентСервер.НайтиЭлементыИГруппыОтбора(Отбор, ИмяПоля) Цикл
		Если ТипЗнч(Элемент) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			Отбор.Элементы.Удалить(Элемент);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
#КонецОбласти