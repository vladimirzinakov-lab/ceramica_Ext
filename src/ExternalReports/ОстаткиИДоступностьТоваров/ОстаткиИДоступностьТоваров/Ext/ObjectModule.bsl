#КонецОбласти

#Область ОграничениеДоступаКСкладам

// Фиксированный список складов, доступных в отчёте. Ведёт разработчик.
// Указывается наименование склада (см. СкладыПоОписаниям).
// Пустой список означает, что ограничение не применяется (режим разработки).
Функция ОписанияРазрешенныхСкладов() Экспорт

	Описания = Новый Массив;
	Описания.Добавить("Склад Логистика");
	Описания.Добавить("Склад Ангар");
	Описания.Добавить("Склад Ангар-7");
	Описания.Добавить("Таможня");
	Описания.Добавить("Склад бытовой техники");

	Возврат Описания;

КонецФункции

// Склады из фиксированного списка, доступные текущему пользователю.
//
// Возвращаемое значение:
//   Массив из СправочникСсылка.Склады
//
Функция РазрешенныеСклады() Экспорт

	Возврат СкладыПоОписаниям(ОписанияРазрешенныхСкладов());

КонецФункции

// Разрешает описания складов (наименования) в ссылки, доступные пользователю.
//
// Параметры:
//   Описания - Массив из Строка - наименования складов.
//
// Возвращаемое значение:
//   Массив из СправочникСсылка.Склады
//
Функция СкладыПоОписаниям(Описания) Экспорт

	ОписанияДляПоиска = Новый Массив;
	Для Каждого Описание Из Описания Цикл
		Если ЗначениеЗаполнено(Описание) Тогда
			ОписанияДляПоиска.Добавить(Строка(Описание));
		КонецЕсли;
	КонецЦикла;

	Если ОписанияДляПоиска.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Склады.Ссылка КАК Склад
	|ИЗ
	|	Справочник.Склады КАК Склады
	|ГДЕ
	|	Склады.Наименование В(&Описания)
	|УПОРЯДОЧИТЬ ПО
	|	Склады.Наименование";
	Запрос.УстановитьПараметр("Описания", ОписанияДляПоиска);

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Склад");

КонецФункции

// Ограничивает отбор по складу фиксированным списком отчёта.
// Если отбор по складу уже установлен (его ставит форма выбора складов), он не меняется.
// Если отбора нет (отчёт открыт без своей формы) — ставится отбор по всем разрешённым складам.
// По полю «Склад» в фиксированных настройках остаётся ровно один элемент: если их больше,
// платформа не применяет настройки («Пересекаются элементы отбора»).
Процедура ОграничитьОтборПоСкладам() Экспорт
	
	Описания = ОписанияРазрешенныхСкладов();
	Если Описания.Количество() = 0 Тогда
		Сообщить("Остатки и доступность товаров: фиксированный список складов не заполнен —"
			+ " отчёт построен по всем складам.", СтатусСообщения.Внимание);
		Возврат;
	КонецЕсли;
	
	// Отбор по складу пришёл от расшифровки (вид сравнения «В списке», представление настройки
	// очищено) — не трогаем его, иначе расшифровка потеряет сужение по складу.
	Для Каждого ЭлементРасшифровки Из ОбщегоНазначенияКлиентСервер.НайтиЭлементыИГруппыОтбора(
		КомпоновщикНастроек.Настройки.Отбор, "Склад") Цикл
		Если ТипЗнч(ЭлементРасшифровки) = Тип("ЭлементОтбораКомпоновкиДанных")
			И ЭлементРасшифровки.Использование
			И ЭлементРасшифровки.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	// Из настроек варианта отбор по складу убираем: иначе фиксированные настройки по тому же полю
	// платформа не применяет («Невозможно применить фиксированные настройки. Пересекаются элементы отбора»).
	Для Каждого Элемент Из ОбщегоНазначенияКлиентСервер.НайтиЭлементыИГруппыОтбора(КомпоновщикНастроек.Настройки.Отбор, "Склад") Цикл
		Если ТипЗнч(Элемент) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			КомпоновщикНастроек.Настройки.Отбор.Элементы.Удалить(Элемент);
		КонецЕсли;
	КонецЦикла;
	
	Отбор = КомпоновщикНастроек.ФиксированныеНастройки.Отбор;
	
	ПервыйЭлемент = Неопределено;
	Для Каждого Элемент Из ОбщегоНазначенияКлиентСервер.НайтиЭлементыИГруппыОтбора(Отбор, "Склад") Цикл
		Если ТипЗнч(Элемент) <> Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
		Если ПервыйЭлемент = Неопределено Тогда
			ПервыйЭлемент = Элемент;
		Иначе
			Отбор.Элементы.Удалить(Элемент);
		КонецЕсли;
	КонецЦикла;
	
	Если ПервыйЭлемент <> Неопределено Тогда
		// Отбор по складу задан формой (выбор складов галочками) — не дублируем его.
		Возврат;
	КонецЕсли;
	
	Разрешенные = РазрешенныеСклады();
	Если Разрешенные.Количество() = 0 Тогда
		Сообщить("Остатки и доступность товаров: в базе не найдены склады из фиксированного списка"
			+ " (" + СтрСоединить(Описания, ", ") + "). Отчёт будет пустым.", СтатусСообщения.Внимание);
	ИначеЕсли Разрешенные.Количество() < Описания.Количество() Тогда
		Сообщить("Остатки и доступность товаров: из фиксированного списка складов доступно "
			+ Разрешенные.Количество() + " из " + Описания.Количество()
			+ " — часть складов не найдена в базе или недоступна пользователю.",
			СтатусСообщения.Внимание);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		Отбор, "Склад", Разрешенные, ВидСравненияКомпоновкиДанных.ВСписке);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли