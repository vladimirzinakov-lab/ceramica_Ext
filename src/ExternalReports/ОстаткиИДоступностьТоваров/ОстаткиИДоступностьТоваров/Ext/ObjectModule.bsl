#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Регистрационные сведения для справочника «Дополнительные отчеты и обработки».
// Шаблон взят из рабочего образца ОстаткиИДоступностьТоваровМ_ОбразецРасшифровки.erf.
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.3.393");
	ПараметрыРегистрации.Информация = НСтр("ru = 'Отчет Остатки и доступность товаров (43-1)'");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительныйОтчет();
	ПараметрыРегистрации.Версия = "1.0.0.1";
	
	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = НСтр("ru = 'Отчет Остатки и доступность товаров'");
	Команда.Идентификатор = "ОтчетОстаткиИДоступностьТоваров";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	Команда.ПоказыватьОповещение = Ложь;
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ПользовательскиеНастройкиМодифицированы = Ложь;

	// Ограничение складов фиксированным списком отчёта (см. #Область ОграничениеДоступаКСкладам).
	ОграничитьОтборПоСкладам();

	ЗначениеПоиска = Новый ПараметрКомпоновкиДанных("СтрокаСейчас");
	ЭлементПараметрыДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ЗначениеПоиска);
	ЭлементПараметрыДанных.Значение = НСтр("ru = 'В наличии'");

	ЗначениеПоиска = Новый ПараметрКомпоновкиДанных("СтрокаСейчасКонтрольКачестваВыключен");
	ЭлементПараметрыДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ЗначениеПоиска);
	ЭлементПараметрыДанных.Значение = НСтр("ru = 'В наличии'");

	ЗначениеПоиска = Новый ПараметрКомпоновкиДанных("СтрокаСПодтвержденнымКачеством");
	ЭлементПараметрыДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ЗначениеПоиска);
	ЭлементПараметрыДанных.Значение = НСтр("ru = 'С подтвержденным качеством'");

	ЗначениеПоиска = Новый ПараметрКомпоновкиДанных("СтрокаНаКонтролеКачества");
	ЭлементПараметрыДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ЗначениеПоиска);
	ЭлементПараметрыДанных.Значение = НСтр("ru = 'На контроле качества'");

	ЗначениеПоиска = Новый ПараметрКомпоновкиДанных("СтрокаНеПодлежитРазблокировке");
	ЭлементПараметрыДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ЗначениеПоиска);
	ЭлементПараметрыДанных.Значение = НСтр("ru = 'Не подлежит разблокировке'");

	ЗначениеПоиска = Новый ПараметрКомпоновкиДанных("СтрокаОжидается");
	ЭлементПараметрыДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ЗначениеПоиска);
	ЭлементПараметрыДанных.Значение = НСтр("ru = 'Ожидается'");

	ЗначениеПоиска = Новый ПараметрКомпоновкиДанных("СтрокаОжидаетсяНеПодлежитРазблокировке");
	ЭлементПараметрыДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ЗначениеПоиска);
	ЭлементПараметрыДанных.Значение = НСтр("ru = 'Ожидается, не подлежит разблокировке'");

	ЗначениеПоиска = Новый ПараметрКомпоновкиДанных("СтрокаВсего");
	ЭлементПараметрыДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ЗначениеПоиска);
	ЭлементПараметрыДанных.Значение = НСтр("ru = 'Всего'");

	УстановитьОбязательныеНастройки(ПользовательскиеНастройкиМодифицированы);

	// Правки структуры настроек, сделанные в форме, до компоновки не доходят (передаются только
	// пользовательские и фиксированные настройки), поэтому готовим колонки здесь.
	ПодготовитьНастройкиКолонок();

	// Вызов из самообслуживания.
	Если ОбщегоНазначенияУТКлиентСервер.АвторизованВнешнийПользователь() Тогда
		ПараметрВыводитьОтбор = КомпоновщикНастроек.Настройки.ПараметрыВывода.Элементы.Найти("ВыводитьОтбор");
		Если ПараметрВыводитьОтбор <> Неопределено Тогда
			ПараметрВыводитьОтбор.Использование = Истина;
			ПараметрВыводитьОтбор.Значение = ТипВыводаТекстаКомпоновкиДанных.НеВыводить;
		КонецЕсли;
	КонецЕсли;

	// Стандартная компоновка отчета.
	НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();

	ТекстЗапроса = СхемаКомпоновкиДанных.НаборыДанных.Основной.Запрос;

	ИменаТаблиц = ОбеспечениеВДокументахСервер.НовыеИменаТаблицДляРаспределенияЗапасов();
	ИменаТаблиц.Остатки = "ЗапасыИПотребностиОстатки"; // @query-part-1
	ИменаТаблиц.ОстаткиКонтролируемыхПартий = "ЗапасыИПотребностиОстаткиКонтролируемыхПартий"; // @query-part-1
	ИменаТаблиц.Результат = "ПодстановкаРасчетРезервов"; // @query-part-1

	ОбеспечениеВДокументахСервер.РаспределениеЗапасов(ТекстЗапроса, ИменаТаблиц);

	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"&ТекстЗапросаВесНоменклатуры",
		Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаВесУпаковки("Таблица.Номенклатура.ЕдиницаИзмерения", "Таблица.Номенклатура"));

	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"&ТекстЗапросаОбъемНоменклатуры",
		Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаОбъемУпаковки("Таблица.Номенклатура.ЕдиницаИзмерения", "Таблица.Номенклатура"));


	СхемаКомпоновкиДанных.НаборыДанных.Основной.Запрос = ТекстЗапроса;

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиОтчета, ДанныеРасшифровки);

	КомпоновкаДанныхСервер.УстановитьЗаголовкиМакетаКомпоновки(ПараметризуемыеЗаголовкиПолей(), МакетКомпоновки);

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки, Истина);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

	КомпоновкаДанныхСервер.СкрытьВспомогательныеПараметрыОтчета(СхемаКомпоновкиДанных, КомпоновщикНастроек, ДокументРезультат, ВспомогательныеПараметрыОтчета());

	// Сообщим форме отчета, что настройки модифицированы
	Если ПользовательскиеНастройкиМодифицированы Тогда
		КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ПользовательскиеНастройкиМодифицированы", Истина);
	КонецЕсли;

КонецПроцедуры

// Подготавливает колонки таблицы настроек перед компоновкой:
// - убирает группу колонок, не соответствующую функциональной опции «Контроль качества товаров»;
// - включает/выключает группировки «Дата доступности» по флажку «Доступность по датам» формы.
//
// Флажок форма передаёт в дополнительных свойствах пользовательских настроек компоновщика:
// сами пользовательские настройки группировок платформа при формировании сбрасывает к варианту,
// а правки структуры настроек, сделанные в форме, до компоновки не доходят.
// Если флажок не передан (отчёт открыт без своей формы) — колонки дат включены.
//
Процедура ПодготовитьНастройкиКолонок()
	
	ИмяОтключаемойГруппировки = ?(ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольКачестваТоваров"),
		"КонтрольКачестваВыключен",
		"КонтрольКачестваВключен");
	
	ДоступностьПоДатам = Истина;
	ДополнительныеСвойстваНастроек = КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства;
	Если ДополнительныеСвойстваНастроек.Свойство("ДоступностьПоДатам") Тогда
		ДоступностьПоДатам = ДополнительныеСвойстваНастроек.ДоступностьПоДатам = Истина;
	КонецЕсли;
	
	Для Каждого ЭлементСтруктуры Из КомпоновщикНастроек.Настройки.Структура Цикл
		
		Если ТипЗнч(ЭлементСтруктуры) <> Тип("ТаблицаКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
		
		МассивУдаляемых = Новый Массив;
		Для Каждого КолонкаКомпоновки Из ЭлементСтруктуры.Колонки Цикл
			Если ТипЗнч(КолонкаКомпоновки) = Тип("ГруппировкаТаблицыКомпоновкиДанных")
				И КолонкаКомпоновки.Имя = ИмяОтключаемойГруппировки Тогда
				МассивУдаляемых.Добавить(КолонкаКомпоновки);
			КонецЕсли;
		КонецЦикла;
		Для Каждого КолонкаКомпоновки Из МассивУдаляемых Цикл
			ЭлементСтруктуры.Колонки.Удалить(КолонкаКомпоновки);
		КонецЦикла;
		
		Для Каждого ИмяГруппировкиДат Из Новый Структура("КонтрольКачестваДатаДоступности, ДатаДоступностиДляСамообслуживания") Цикл
			Для Каждого КолонкаКомпоновки Из ЭлементСтруктуры.Колонки Цикл
				ГруппировкаДат = НайтиГруппировкуКолонокРекурсивно(КолонкаКомпоновки, ИмяГруппировкиДат.Ключ);
				Если ГруппировкаДат = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				ГруппировкаДат.Использование = ДоступностьПоДатам;
				ПользовательскийЭлемент = КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(
					ГруппировкаДат.ИдентификаторПользовательскойНастройки);
				Если ПользовательскийЭлемент <> Неопределено Тогда
					ПользовательскийЭлемент.Использование = ДоступностьПоДатам;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Ищет группировку колонок по имени среди вложенных группировок.
Функция НайтиГруппировкуКолонокРекурсивно(ЭлементНастроек, ИмяГруппировки)
	
	Если ТипЗнч(ЭлементНастроек) <> Тип("ГруппировкаТаблицыКомпоновкиДанных") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЭлементНастроек.Имя = ИмяГруппировки Тогда
		Возврат ЭлементНастроек;
	КонецЕсли;
	
	Для Каждого Элемент Из ЭлементНастроек.Структура Цикл
		НайденнаяГруппировка = НайтиГруппировкуКолонокРекурсивно(Элемент, ИмяГруппировки);
		Если НайденнаяГруппировка <> Неопределено Тогда
			Возврат НайденнаяГруппировка;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Настройки общей формы отчета подсистемы "Варианты отчетов".
//
// Параметры:
//   Форма - ФормаКлиентскогоПриложения - Форма отчета.
//   КлючВарианта - Строка - Имя предопределенного варианта отчета или уникальный идентификатор пользовательского.
//   Настройки - См. ОтчетыКлиентСервер.ПолучитьНастройкиОтчетаПоУмолчанию
//
Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт

	Настройки.События.ПриСозданииНаСервере = Истина;
	Настройки.События.ПередЗагрузкойВариантаНаСервере = Истина;
	Настройки.События.ПередЗаполнениемПанелиБыстрыхНастроек	= Истина;
	Настройки.События.ПередЗагрузкойНастроекВКомпоновщик = Истина;

КонецПроцедуры

Процедура ПередЗагрузкойНастроекВКомпоновщик(Контекст, КлючСхемы, КлючВарианта, НовыеНастройкиКД, НовыеПользовательскиеНастройкиКД) Экспорт

	Если НовыеНастройкиКД = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если КлючСхемы = КлючВарианта Тогда
		Возврат;
	КонецЕсли;

	ИмяОтключаемойГруппировки = ?(ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольКачестваТоваров"),
		"КонтрольКачестваВыключен",
		"КонтрольКачестваВключен");

	СтруктураНастроек = НовыеНастройкиКД.Структура;
	Для Каждого ЭлементСтруктуры Из СтруктураНастроек Цикл
		Если ТипЗнч(ЭлементСтруктуры) = Тип("ТаблицаКомпоновкиДанных") Тогда

			Для Каждого СтрокаКомпоновки Из ЭлементСтруктуры.Строки Цикл
				Если ТипЗнч(СтрокаКомпоновки) = Тип("ГруппировкаТаблицыКомпоновкиДанных") Тогда
					Если СтрокаКомпоновки.Имя = ИмяОтключаемойГруппировки Тогда
						ЭлементСтруктуры.Строки.Удалить(СтрокаКомпоновки);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Для Каждого КолонкаКомпоновки Из ЭлементСтруктуры.Колонки Цикл
				Если ТипЗнч(КолонкаКомпоновки) = Тип("ГруппировкаТаблицыКомпоновкиДанных") Тогда
					Если КолонкаКомпоновки.Имя = ИмяОтключаемойГруппировки Тогда
						ЭлементСтруктуры.Колонки.Удалить(КолонкаКомпоновки);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;

		ИначеЕсли ТипЗнч(ЭлементСтруктуры) = Тип("ГруппировкаКомпоновкиДанных") Тогда

			Если ЭлементСтруктуры.Имя = ИмяОтключаемойГруппировки Тогда
				СтруктураНастроек.Элементы.Удалить(ЭлементСтруктуры);
			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Вызывается до перезаполнения панели настроек формы отчета.
//
// Параметры:
//   Форма - ФормаКлиентскогоПриложения - форма отчета.
//   ПараметрыЗаполнения - Структура - параметры, которые будут загружены в отчет.
//
Процедура ПередЗаполнениемПанелиБыстрыхНастроек(Форма, ПараметрыЗаполнения) Экспорт
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьОбособленноеОбеспечениеЗаказов") Тогда
		ПараметрыДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных;
		ПараметрДанных = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметркомпоновкиДанных("ПоказатьОбособленныеТовары"));
		ПараметрДанных.ИдентификаторПользовательскойНастройки = "";
	КонецЕсли;
КонецПроцедуры

// Вызывается в одноименном обработчике формы отчета после выполнения кода формы.
//
// Подробнее - см. ОтчетыПереопределяемый.ПередЗагрузкойВариантаНаСервере
//
Процедура ПередЗагрузкойВариантаНаСервере(ЭтаФорма, НовыеНастройкиКД) Экспорт

	Отчет = ЭтаФорма.Отчет;
	КомпоновщикНастроекФормы = Отчет.КомпоновщикНастроек;

	// Изменение настроек по функциональным опциям
	НастроитьПараметрыОтборыПоФункциональнымОпциям(КомпоновщикНастроекФормы);

КонецПроцедуры

// Вызывается в обработчике одноименного события формы отчета после выполнения кода формы.
//
// Параметры:
//   Форма - ФормаКлиентскогоПриложения - Форма отчета.
//   Отказ - Булево - Передается из параметров обработчика "как есть".
//   СтандартнаяОбработка - Булево - Передается из параметров обработчика "как есть".
//
// См. также:
//   "ФормаКлиентскогоПриложения.ПриСозданииНаСервере" в синтакс-помощнике.
//
Процедура ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт

	Параметры = Форма.Параметры;

	Если Параметры.Свойство("ПараметрКоманды") Тогда

		Если Параметры.Свойство("ОписаниеКоманды")
			И Параметры.ОписаниеКоманды.Свойство("ДополнительныеПараметры") Тогда

			// Структура с полями из ВариантыОтчетовПереопределяемый.ПередДобавлениемКомандОтчетов.КомандыОтчетов.
			ОписаниеКоманды = Параметры.ОписаниеКоманды; // Структура -
			ДополнительныеПараметрыКоманды = ОписаниеКоманды.ДополнительныеПараметры; // Структура -
			Если ДополнительныеПараметрыКоманды.ИмяКоманды = "ОстаткиИДоступность" Тогда
				Форма.ФормаПараметры.Отбор.Вставить("Номенклатура", Параметры.ПараметрКоманды);
			КонецЕсли;
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьОбязательныеНастройки(ПользовательскиеНастройкиМодифицированы)

	СегментыСервер.ВключитьОтборПоСегментуНоменклатурыВСКД(КомпоновщикНастроек);

КонецПроцедуры

