// Возвращает комментарий из файла метаданных обработки (.mdo).
//
// Параметры:
//  ПутьФайлMDO - Строка - полный путь к файлу .mdo.
//
// Возвращаемое значение:
//  Строка - значение элемента <comment>. Пустая строка, если элемент отсутствует.
//
Функция ПолучитьКомментарийMDO(ПутьФайлMDO)

	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ПутьФайлMDO);

	Комментарий = "";
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента
			И Чтение.ЛокальноеИмя = "comment" Тогда

			Если Чтение.Прочитать()
				И Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
				Комментарий = Чтение.Значение;
			КонецЕсли;
			Прервать;

		КонецЕсли;
	КонецЦикла;

	Чтение.Закрыть();

	Возврат Комментарий;

КонецФункции

// Копирование файла в другую папку с добавлением даты к имени файла.

ПапкаСкрипт	= АргументыКоманднойСтроки[0];
ИмяФайла	= АргументыКоманднойСтроки[1];

ПапкаПриемник	= ТекущийКаталог();
ПутьBin			= ОбъединитьПути(ПапкаСкрипт, "..", "bin");
Источник		= ПутьBin + "\" + ИмяФайла;

Файл_Источник = Новый Файл(Источник);
Если Не Файл_Источник.Существует() Тогда
	Сообщить("Файл не найден: " + Источник);
	ЗавершитьРаботу(1);
КонецЕсли;

Файл_Приемник = Новый Файл(ПапкаПриемник);
Если Не Файл_Приемник.Существует() Тогда
	Сообщить("Папка-приемник не найден: " + ПапкаПриемник);
	ЗавершитьРаботу(1);
КонецЕсли;

// Отделяем расширение от имени файла
ИмяБезРасширения = ИмяФайла;
Расширение = "";

ПозицияТочки = СтрНайти(ИмяФайла, ".", НаправлениеПоиска.СКонца);
Если ПозицияТочки > 0 Тогда
	ИмяБезРасширения = Лев(ИмяФайла, ПозицияТочки - 1);
	Расширение = Сред(ИмяФайла, ПозицияТочки + 1);
КонецЕсли;

//ДатаСтрокой = Формат(ТекущаяДата(), "ДФ=ddMMyy");
ДатаСтрокой = Формат(Файл_Источник.ПолучитьВремяИзменения(), "ДФ=ddMMyy");

ПутьФайлMDO	= ОбъединитьПути(ПапкаСкрипт, "..", "src\ExternalDataProcessors\" + ИмяБезРасширения + "\" + ИмяБезРасширения +".mdo");

Сообщить("Путь MDO: " + ПутьФайлMDO);

Файл_MDO = Новый Файл(ПутьФайлMDO);
Если Не Файл_MDO.Существует() Тогда
	Сообщить("Файл MDO не найден: " + ПутьФайлMDO);
	ЗавершитьРаботу(1);
КонецЕсли;

Комментарий_Task = ПолучитьКомментарийMDO(ПутьФайлMDO);

НовоеИмя = Комментарий_Task +"_"+ ИмяБезРасширения + " " + ДатаСтрокой;

Если Расширение <> "" Тогда
	НовоеИмя = НовоеИмя + "." + Расширение;
КонецЕсли;

Приемник = ПапкаПриемник + "\" + НовоеИмя;

КопироватьФайл(Источник, Приемник);
Сообщить("Файл скопирован: " + Приемник);